<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/status_placeholder"
            android:textSize="13sp" />

        <!-- Agreements -->
        <LinearLayout
            android:id="@+id/groupAgreements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_agreements"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAgreementLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/agreement_loading"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/groupAgreementFailure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvAgreementError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/agreement_unavailable_hint" />

                <Button
                    android:id="@+id/btnRetryAgreements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/retry" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupAgreementRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPrivacyAgreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/agreement_privacy" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbPrivacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agreement_accept" />

                    <Button
                        android:id="@+id/btnViewPrivacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_document" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUserAgreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/agreement_user" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbUserAgreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agreement_accept" />

                    <Button
                        android:id="@+id/btnViewUserAgreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_document" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnReloadAgreements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reload_agreements" />
            </LinearLayout>
        </LinearLayout>

        <!-- QR -->
        <LinearLayout
            android:id="@+id/groupQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_qr"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/qrBox"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="#11000000"
                android:gravity="center"
                android:text="@string/qr_payload"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_long_press_skip"
                android:textStyle="italic" />

            <Button
                android:id="@+id/btnRefreshSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh_session" />
        </LinearLayout>

        <!-- Error -->
        <LinearLayout
            android:id="@+id/groupError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_error"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry" />
        </LinearLayout>

        <!-- Login continuation -->
        <LinearLayout
            android:id="@+id/groupLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_login"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_hint" />

            <Button
                android:id="@+id/btnRetryLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry_login" />

            <TextView
                android:id="@+id/tvContinuation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continuation_hint"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnContinuation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/continuation_accept"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Privacy -->
        <LinearLayout
            android:id="@+id/groupPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_privacy"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_hint" />

            <Button
                android:id="@+id/btnRetryPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry" />
        </LinearLayout>

        <!-- Entered banner -->
        <TextView
            android:id="@+id/tvEntered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Debug panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_section"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbRearSeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_rear_seat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/debug_scenario" />

            <Spinner
                android:id="@+id/spinnerScenario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_restart" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
